{
  "name": "restaurantpro",
  "version": "1.0.0",
  "private": true,
  "description": "RestaurantPro - Restaurant Management System",
  "scripts": {
    "all": "node run-all.js",
    "dev": "node run-all.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start": "node run-all.js",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "postinstall": "npm run install:all",
    "test": "npm run test:api --prefix backend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.2"
  }
}
